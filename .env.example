# ---- LLM ----
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# ---- Secrets: generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))" ----
AGENT_SECURITY_SECRET=replace_with_48_char_random_secret_AAAAAAAAAAAAAAAA
WEBHOOK_SIGNING_SECRET=replace_with_48_char_random_secret_BBBBBBBBBBBBBBBB
ERP_INTERNAL_API_KEY=replace_with_24plus_char_internal_service_key

# ---- Role API keys (24+ chars, all different) ----
ADMIN_API_KEY=replace_with_admin_api_key_24_chars
OPERATOR_API_KEY=replace_with_operator_api_key_24_chars
APPROVER_API_KEY=replace_with_approver_api_key_24_chars
AUDITOR_API_KEY=replace_with_auditor_api_key_24_chars
DEFAULT_TENANT_ID=tenant-default
# Optional extra users (other tenants), one-line JSON:
# EXTRA_USERS_JSON=[{"key":"acme_operator_key_24_chars_xxxx","user_id":"usr-acme-op","tenant_id":"tenant-acme","role":"OPERATOR"}]

# ---- Environment / storage / ERP ----
ENVIRONMENT=development
DB_PATH=erp_crm_enterprise.db
ERP_API_BASE_URL=http://127.0.0.1:8001

# ---- Optional approval webhook (https + public host in production) ----
# APPROVAL_WEBHOOK_URL=https://approvals.example.com/hooks/agent
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false   # dev-only; ignored in production

# ---- Agent bounds ----
MAX_PLAN_STEPS=8
MAX_RETRIES=3
APPROVAL_TTL_SECONDS=600
